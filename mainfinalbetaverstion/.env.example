# ThreatWatch Enterprise — Environment Configuration Template
# Copy this file to `.env` and fill in your real credentials.
# The real `.env` file is gitignored and should NEVER be committed.

# ── Supabase Cloud Configuration ──────────────────────
# Get these from: https://supabase.com → Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# ── Google Gemini AI Configuration ────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── System Settings ────────────────────────────────────
APP_ENVIRONMENT=development
DEBUG_MODE=false
